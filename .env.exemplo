# Chave da API do Google Gemini (Google AI Studio)
GEMINI_API_KEY=sua_chave_aqui

# Chave da API da Cohere (Dashboard ou Trial Key)
COHERE_API_KEY=sua_chave_aqui

# Chave da API da Groq (Groq Console)
GROQ_API_KEY=sua_chave_aqui

# Discord
DISCORD_TOKEN=seu_token_aqui
CANAL_ID=seu_canal_id_aqui

# Mailtrap
MAILTRAP_API_TOKEN=seu_token_aqui

# Instagram
INSTAGRAM_USER_ID=seu_user_id_aqui
META_ACCESS_TOKEN=seu_token_aqui
GRAPH_VERSION=v26.0

# Configurações do Servidor Flask Local
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Opcional: Se usa ngrok autenticado
NGROK_AUTH_TOKEN=seu_token_aqui
